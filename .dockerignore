xtend/.env
xtend/resume-public.json
xtend/.xtend-build
xtend/public
xtend/evidence
**/__pycache__
**/*.pyc

# Legacy Docker builders read this root file, even with -f Dockerfile.control.
!Dockerfile.control
!Dockerfile.control.dockerignore
!Dockerfile.searxng
!Dockerfile.searxng.dockerignore
!compose.control.yml
!compose.portainer.yml
xtend/.control
xtend/.env*
**/*.sqlite*
**/owner.lock

xtend/.evidence
