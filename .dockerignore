*

!container/*.template.*
!container/entrypoint.sh
!searx/**
!requirements*.txt

# Integration build (also for Docker's legacy builder)
!.dockerignore
!LICENSE
!Dockerfile.xtend
!Dockerfile.xtend.dockerignore
!compose.xtend.yml
!README-XTEND.md
