# Import template for Portainer > Load variables from .env file.
# Fill BEFORE importing/deploying. Blank values intentionally stop deployment.
# Alternatively add these values directly to the stack's Environment variables.
# Uploading only the Compose YAML does NOT import this template automatically.
PUBLIC_BASE_URL=https://search.ccs-networks.de
XTEND_PORT=8090
NEXTCLOUD_BASE_URL=https://vm.ccs-networks.de/cloud/
NEXTCLOUD_INDEX_PHP=0

# Generate a shared backend token, e.g. with: openssl rand -hex 48
# Paste the command OUTPUT below, not the command itself. This is an internal
# XTend/SearXNG key; it is independent of the Nextcloud client secret.
# Keep the existing token when updating an existing installation.
SEARXNG_TOKEN=
NEXTCLOUD_CLIENT_ID=
NEXTCLOUD_CLIENT_SECRET=
XTEND_ADMIN_ROLES={"EXAKTE_NEXTCLOUD_KENNUNG":"administrator"}

XTEND_PROBES=0
XTEND_ADMIN_MUTATIONS=1
XTEND_STREAMING=1
XTEND_KNOWLEDGE=1
XTEND_SEARCH_IMAGE=xtend-search:0.4.4
XTEND_BACKEND_IMAGE=xtend-search-searxng:0.4.2
XTEND_CONTROL_VOLUME=xtend-search-control_control-data
XTEND_BACKEND_VOLUME=xtend-search-control_backend-data

XTEND_EVIDENCE_VOLUME=xtend-search-control_evidence-data
XTEND_FAVICON_RESOLVER=duckduckgo
