# syntax=docker/dockerfile:1
ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
FROM ${PYTHON_IMAGE}
LABEL org.opencontainers.image.version="0.4.0" org.opencontainers.image.title="XTend.search SearXNG backend"
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends tini ca-certificates && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 searx && useradd --uid 10001 --gid 10001 --no-create-home searx \
 && mkdir -p /var/lib/xtend-backend && chown 10001:10001 /var/lib/xtend-backend
COPY xtend/requirements.lock.txt /app/xtend/requirements.lock.txt
RUN pip install --no-cache-dir -r /app/xtend/requirements.lock.txt
COPY searx /app/searx
COPY xtend/server/backend.py xtend/server/backend-start.py xtend/server/favicon_backend.py /app/xtend/server/
COPY xtend/config/settings.control.yml xtend/config/settings.control.fixture.yml /app/xtend/config/
COPY LICENSE /app/LICENSE
RUN python -c 'from pathlib import Path; Path("searx/version_frozen.py").write_text("VERSION_STRING = \"2026.9.19+e831fc2a1+xtend-backend.0.4.0\"\nVERSION_TAG = \"2026.9.19+e831fc2a1\"\nDOCKER_TAG = \"xtend-search-backend-0.4.0\"\nGIT_URL = \"https://github.com/searxng/searxng\"\nGIT_BRANCH = \"xtend-search\"\n")'
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SEARXNG_SETTINGS_PATH=/app/xtend/config/settings.control.yml
USER 10001:10001
EXPOSE 8082
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s CMD python -c 'import urllib.request; urllib.request.urlopen("http://127.0.0.1:8082/healthz",timeout=3)'
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["python","xtend/server/backend-start.py"]
